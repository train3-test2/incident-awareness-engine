# Run docker compose with --env-file .env.localstack.
# Keep this local file out of Git if you change the password.
LOCAL_POSTGRES_USER=incident_admin
LOCAL_POSTGRES_PASSWORD=local_dev_password
LOCAL_POSTGRES_DB=incident_awareness_local
LOCAL_POSTGRES_PORT=54330

# This URL uses the Compose service name, not 127.0.0.1.
LOCAL_DATABASE_URL=postgresql://incident_admin:local_dev_password@postgres:5432/incident_awareness_local

LOCAL_AWS_REGION=ap-northeast-2
LOCALSTACK_PORT=4566
LOCAL_FIRST_CYCLE_BUCKET=incident-awareness-local-first-cycle
LOCAL_FIRST_CYCLE_QUEUE=incident-awareness-local-first-cycle-ingest
LOCAL_FIRST_CYCLE_DLQ=incident-awareness-local-first-cycle-dlq
