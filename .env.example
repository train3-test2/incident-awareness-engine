APP_ENV=local

# MonoRouter: explicit development opt-in, synthetic fixture only in this phase.
# Inject the key in the server environment; never commit it or pass it to the browser.
IAE_MONOROUTER_ENABLED=0
IAE_MONOROUTER_ENDPOINT=https://monogpt.kr/api/monorouter/v1/anthropic/v1/messages
IAE_MONOROUTER_MODEL=claude-haiku-4.5
IAE_MONOROUTER_RESPONSE_MODEL=claude-haiku-4-5-20251001
IAE_MONOROUTER_CONNECT_TIMEOUT=3
IAE_MONOROUTER_READ_TIMEOUT=25
IAE_MONOROUTER_MAX_TOKENS=1200
IAE_MONOROUTER_API_KEY=
# Local server-side SQLite ledger; blank uses build/grounded-reports/drafts.sqlite3.
IAE_REPORT_STORE_PATH=
# Optional read-only ledger containing a previous successful synthetic connection check.
IAE_MONOROUTER_VERIFICATION_STORE_PATH=
INCIDENT_AWARENESS_EVENT_TYPES_PATH=configs/event_types_v0.2.yaml

# Local PostgreSQL Docker Compose. Set POSTGRES_PASSWORD only in a local .env file.
POSTGRES_USER=incident_admin
POSTGRES_PASSWORD=
POSTGRES_DB=incident_awareness
POSTGRES_PORT=54329
INCIDENT_AWARENESS_DATABASE_URL=

# Repository integration tests require TEST_DATABASE_URL. If its database name
# does not include "test", set INCIDENT_AWARENESS_TEST_DATABASE=true explicitly.
TEST_DATABASE_URL=
INCIDENT_AWARENESS_TEST_DATABASE=

AWS_REGION=
S3_BUCKET=

# Dashboard EvaluationSnapshot startup materialization.
INCIDENT_AWARENESS_EVALUATION_SNAPSHOT_S3_URI=
INCIDENT_AWARENESS_EVALUATION_SNAPSHOT_PATH=/evaluation/current-snapshot.json
# Optional read-only retained Run archives: <root>/<run_id>/manifest.json + telemetry/.
# Unset means raw verification remains unavailable; never alias another Run's archive.
# IAE_PROVENANCE_ARCHIVE_ROOT=/path/to/retained-run-archives
# Raw retention (requires migration 015): 1 keeps upload bytes, the Run manifest and
# generation-time Evidence in PostgreSQL before a successful Receipt. Upload API, Worker and
# Standalone must share the setting. Unset keeps the previous behavior; old Runs are never
# backfilled.
# IAE_RAW_RETENTION_ENABLED=1
# Optional required replica (content-addressed, atomic no-replace). PostgreSQL stays the
# recovery source; a missing replica file is republished, a conflicting one is never replaced.
# IAE_RAW_ARCHIVE_MIRROR_ROOT=/path/to/raw-archive-mirror
