{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GetEcrAuthorizationToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushSmokeImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "ECR_REPOSITORY_ARN"
    },
    {
      "Sid": "ReadFirstCycleInputArtifactMetadata",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "FIRST_CYCLE_S3_BUCKET_ARN",
      "Condition": {
        "StringLike": {
          "s3:prefix": "first-cycle/*"
        }
      }
    },
    {
      "Sid": "ReadFirstCycleInputArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "FIRST_CYCLE_S3_OBJECTS_ARN"
    },
    {
      "Sid": "RegisterTaskDefinitions",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "RunSmokeTask",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "ECS_SMOKE_TASK_DEFINITION_ARN"
    },
    {
      "Sid": "RunFirstCycleTask",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "ECS_FIRST_CYCLE_TASK_DEFINITION_ARN"
    },
    {
      "Sid": "RunFirstCycleMigrationTask",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "ECS_FIRST_CYCLE_MIGRATION_TASK_DEFINITION_ARN"
    },
    {
      "Sid": "ManageFirstCycleWorkerService",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DescribeServices"
      ],
      "Resource": "ECS_FIRST_CYCLE_WORKER_SERVICE_ARN",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "ECS_CLUSTER_ARN"
        }
      }
    },
    {
      "Sid": "ReadSmokeTaskStatus",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeClusters",
        "ecs:DescribeTaskDefinition",
        "ecs:DescribeTasks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassTaskExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "ECS_EXECUTION_ROLE_ARN",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassFirstCycleTaskRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "FIRST_CYCLE_TASK_ROLE_ARN",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
